# =========================
# 얼굴 비교
# =========================
@app.route("/compare", methods=["POST"])
def compare():
    global names, vectors

    print("현재 등록 인원:", len(names))

    if len(vectors) == 0:
        print("DB 비어 있음")
        return jsonify([])

    if "photo" not in request.files:
        print("파일 없음")
        return jsonify([])

    file = request.files.get("photo")

    if file is None or file.filename == "":
        print("파일 선택 안됨")
        return jsonify([])

    temp_path = os.path.join(DATA_DIR, "input.jpg")

    try:
        file.save(temp_path)
    except Exception as e:
        print("파일 저장 오류:", e)
        return jsonify([])

    input_emb = get_embedding(temp_path)

    if input_emb is None:
        print("입력 얼굴 임베딩 실패")
        return jsonify([])

    scores = np.dot(vectors, input_emb)

    threshold = 0.7
    idx = np.where(scores >= threshold)[0]

    if len(idx) == 0:
        print("일치 없음")
        return jsonify([])

    result_idx = idx[np.argsort(scores[idx])[::-1]]

    response = []

    for i in result_idx[:5]:

        name = names[i]
        score = float(scores[i])

        person_folder = os.path.join(FACE_DIR, name)

        if not os.path.exists(person_folder):
            continue

        image_list = os.listdir(person_folder)

        if len(image_list) == 0:
            continue

        first_image = image_list[0]

        response.append({
            "name": name,
            "score": round(score * 100, 1),
            "image": f"/faces/{name}/{first_image}"
        })

    print("매칭 성공:", response)

    return jsonify(response)


