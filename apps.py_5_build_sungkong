# =========================
# 얼굴 임베딩 추출
# =========================
def get_embedding(img_path):
    print("이미지 경로:", img_path)

    if not os.path.exists(img_path):
        print("이미지 파일 존재하지 않음")
        return None

    img = cv2.imread(img_path)
    
    print("img:", img) 

    if img is None:
        print("이미지 로딩 실패")
        return None

    try:
        faces = face_app.get(img)
        print("감지된 얼굴 수:", len(faces))
    except Exception as e:
        print("face_app.get 오류:", e)
        return None

    if not faces:
        print("얼굴 없음")
        return None

    emb = faces[0].embedding
    norm = np.linalg.norm(emb)

    if norm == 0:
        print("정규화 실패")
        return None

    print("임베딩 추출 성공")
    return emb / norm


# =========================
# faces 변경 감지용 시그니처
# =========================
def get_faces_signature():
    if not os.path.exists(FACE_DIR):
        return 0

    file_list = []
    for root, dirs, files in os.walk(FACE_DIR):
        for f in files:
            path = os.path.join(root, f)
            file_list.append((path, os.path.getmtime(path)))

    return hash(str(file_list))


# =========================
# DB 생성
# =========================
def build_db():
    print("DB 생성 시작...")

    names = []
    vectors = []

    if not os.path.exists(FACE_DIR):
        print("faces 폴더 없음")
        return [], np.array([])

    for person in os.listdir(FACE_DIR):

        person_path = os.path.join(FACE_DIR, person)

        if not os.path.isdir(person_path):
            continue

        embeddings = []

        for img_file in os.listdir(person_path):

            img_path = os.path.join(person_path, img_file)

            emb = get_embedding(img_path)

            if emb is not None:
                embeddings.append(emb)

        if len(embeddings) > 0:
            mean_emb = np.mean(embeddings, axis=0)
            mean_emb = mean_emb / np.linalg.norm(mean_emb)

            names.append(person)
            vectors.append(mean_emb)

            print(f"{person} 등록 완료")

    if len(vectors) == 0:
        print("등록된 얼굴 없음")
        return [], np.array([])

    vectors = np.array(vectors)

    np.savez(DB_PATH, names=names, vectors=vectors)
    np.save(META_PATH, get_faces_signature())

    print("DB 생성 완료")
    print("등록 인원 수:", len(names))

    return names, vectors


# =========================
# DB 로드 또는 재생성
# =========================
def load_or_build_db():

    if not os.path.exists(DB_PATH) or not os.path.exists(META_PATH):
        return build_db()

    try:
        saved_signature = int(np.load(META_PATH))
    except:
        return build_db()

    current_signature = get_faces_signature()

    if saved_signature != current_signature:
        print("faces 변경 감지 → DB 재생성")
        return build_db()

    try:
        data = np.load(DB_PATH, allow_pickle=True)
        print("DB 로드 완료")
        print("등록 인원 수:", len(data["names"]))
        return data["names"].tolist(), data["vectors"]
    except:
        return build_db()


# 최초 DB 로드
names, vectors = load_or_build_db()


