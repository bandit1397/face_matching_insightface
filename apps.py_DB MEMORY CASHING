import os
import sys
import cv2
import numpy as np
import webbrowser
import threading
from flask import Flask, render_template, request, jsonify, send_from_directory
from insightface.app import FaceAnalysis

# =========================
# 경로 설정 (exe 대응)
# =========================
if getattr(sys, 'frozen', False):
    BASE_DIR = os.path.dirname(sys.executable)  # 🔥 exe 위치 기준
else:
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))

FACE_DIR = os.path.join(BASE_DIR, "faces")
DATA_DIR = os.path.join(BASE_DIR, "data")
DB_PATH = os.path.join(DATA_DIR, "db.npz")
META_PATH = os.path.join(DATA_DIR, "meta.npy")

os.makedirs(DATA_DIR, exist_ok=True)

app = Flask(__name__, template_folder=os.path.join(BASE_DIR, "templates"))

# =========================
# InsightFace 초기화
# =========================
face_app = FaceAnalysis(providers=['CPUExecutionProvider'])
face_app.prepare(ctx_id=0, det_size=(640, 640))

# =========================
# 얼굴 임베딩 추출
# =========================
def get_embedding(img_path):
    img = cv2.imread(img_path)
    if img is None:
        return None

    try:
        faces = face_app.get(img)
    except:
        return None

    if not faces:
        return None

    emb = faces[0].embedding
    norm = np.linalg.norm(emb)
    if norm == 0:
        return None

    return emb / norm


# =========================
# faces 폴더 상태 체크
# =========================
def get_faces_signature():
    file_list = []
    for root, dirs, files in os.walk(FACE_DIR):
        for f in files:
            path = os.path.join(root, f)
            file_list.append((path, os.path.getmtime(path)))
    return hash(str(file_list))


# =========================
# DB 생성
# =========================
def build_db():
    print("DB 생성 시작...")

    names = []
    vectors = []

    for person in os.listdir(FACE_DIR):
        person_path = os.path.join(FACE_DIR, person)
        if not os.path.isdir(person_path):
            continue

        embeddings = []

        for img_file in os.listdir(person_path):
            img_path = os.path.join(person_path, img_file)
            emb = get_embedding(img_path)
            if emb is not None:
                embeddings.append(emb)

        if embeddings:
            mean_emb = np.mean(embeddings, axis=0)
            mean_emb = mean_emb / np.linalg.norm(mean_emb)

            names.append(person)
            vectors.append(mean_emb)

    vectors = np.array(vectors)

    np.savez(DB_PATH, names=names, vectors=vectors)
    np.save(META_PATH, get_faces_signature())

    print("DB 생성 완료")
    return names, vectors


# =========================
# DB 로드 또는 재생성
# =========================
def load_or_build_db():
    if not os.path.exists(DB_PATH) or not os.path.exists(META_PATH):
        return build_db()

    saved_signature = np.load(META_PATH)
    current_signature = get_faces_signature()

    if saved_signature != current_signature:
        print("faces 변경 감지 → DB 재생성")
        return build_db()

    data = np.load(DB_PATH, allow_pickle=True)
    return data["names"].tolist(), data["vectors"]


# 최초 로드
names, vectors = load_or_build_db()


# =========================
# 웹 화면
# =========================
@app.route("/")
def index():
    return render_template("index.html")


# =========================
# 얼굴 비교 (고속)
# =========================
@app.route("/compare", methods=["POST"])
def compare():
    global names, vectors

    file = request.files["photo"]
    temp_path = os.path.join(DATA_DIR, "input.jpg")
    file.save(temp_path)

    input_emb = get_embedding(temp_path)
    if input_emb is None:
        return jsonify([])

    # 🔥 벡터 일괄 연산 (초고속)
    scores = np.dot(vectors, input_emb)

    threshold = 0.7
    idx = np.where(scores >= threshold)[0]

    if len(idx) == 0:
        return jsonify([])

    result_idx = idx[np.argsort(scores[idx])[::-1]]

    response = []

    for i in result_idx[:5]:
        name = names[i]
        score = float(scores[i])

        first_image = os.listdir(os.path.join(FACE_DIR, name))[0]

        response.append({
            "name": name,
            "score": round(score * 100, 1),
            "image": f"/faces/{name}/{first_image}"
        })

    return jsonify(response)


# =========================
# 사진 제공
# =========================
@app.route("/faces/<path:filename>")
def face_image(filename):
    return send_from_directory(FACE_DIR, filename)


# =========================
# 실행
# =========================
if __name__ == "__main__":
    def open_browser():
        webbrowser.open("http://127.0.0.1:5000")

    threading.Timer(1.0, open_browser).start()

    app.run(host="127.0.0.1", port=5000, debug=False)
